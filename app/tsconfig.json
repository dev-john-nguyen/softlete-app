{
  "extends": "@react-native/typescript-config/tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "jsx": "react-native",
    "lib": ["es2015", "es2015.promise", "es2016.array.include", "dom"],
    "strict": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@app/elements": ["src/components/elements/index.ts"],
      "@app/icons": ["src/assets/index.tsx"],
      "@app/ui": ["src/ui/index.ts"],
      "@app/utils": ["src/utils/index.ts"],
      "@app/services": ["src/services/services.ts"],
      "@app/contexts": ["src/contexts/index.ts"]
    },
    "noEmit": true,
    "resolveJsonModule": true,
    "target": "esnext",
    "types": ["jest"]
  }
}
